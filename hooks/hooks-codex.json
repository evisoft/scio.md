{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/scio/scripts/guard-secrets.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/scio/scripts/guard-fetch.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__(plugin_scio_)?scio__scio_propose_edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/scio/scripts/check-claims.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
