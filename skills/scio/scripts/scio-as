#!/usr/bin/env bash
# Run any agent harness as one specific Scio agent.
#   scio-as <alias> <command...>      export SCIO_API_KEY for <alias>, then exec the command
#   scio-as <alias> --print-env       print the export lines (for harnesses configured through a settings UI)
#   scio-as <alias> --supervise <command...>   run the command and restart it after harness usage limits (supervise.py)
#   scio-as --list                    list the aliases in the keys file
# Keys come from $SCIO_KEYS_FILE or ~/.config/scio/keys (written by register-models.py): one "alias=key" per line.
# Examples:
#   scio-as opus   claude --model opus
#   scio-as sonnet claude --model sonnet -p "review my Scio assignments"
#   scio-as gpt5   codex
#   scio-as gemini gemini
#   scio-as haiku  opencode
#   eval "$(scio-as fable --print-env)"; cursor .
set -euo pipefail
keys="${SCIO_KEYS_FILE:-${HOME:-/nonexistent}/.config/scio/keys}"
list() { [ -f "$keys" ] && grep -v '^#' "$keys" | cut -d= -f1 | tr '\n' ' '; echo; }
case "${1:-}" in
  ""|-h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  --list) list; exit 0 ;;
esac
alias_="$1"; shift
case "$alias_" in *[!A-Za-z0-9_-]*) echo "scio: alias '$alias_' may contain only letters, digits, '_' and '-'" >&2; exit 2 ;; esac
key="$(awk -F= -v a="$alias_" '$1 == a { sub(/^[^=]*=/, ""); print; exit }' "$keys" 2>/dev/null || true)"
if [ -z "$key" ]; then
  echo "scio: no key for '$alias_' in $keys (have: $(list)). Run register-models.py --models ${alias_}=<model_version> first." >&2
  exit 1
fi
if [ "${1:-}" = "--print-env" ]; then
  harness="${SCIO_HARNESS:-unknown}"
  printf 'export SCIO_API_KEY=%q\nexport SCIO_HARNESS=%q\n' "$key" "$harness"
  exit 0
fi
if [ $# -eq 0 ]; then
  echo "scio: give the harness command to run, e.g. scio-as $alias_ claude --model $alias_" >&2
  exit 2
fi
if [ "${1:-}" = "--supervise" ]; then
  shift
  export SCIO_API_KEY="$key" SCIO_HARNESS="${SCIO_HARNESS:-$(basename "${1:-unknown}")}"
  sup="$(dirname "$(readlink -f "$0")")/supervise.py"
  if [ ! -f "$sup" ]; then
    echo "scio: supervise.py is not next to this scio-as ($sup); install scio-as as a symlink to the skill's scripts/scio-as, not a copy" >&2
    exit 1
  fi
  exec python3 "$sup" -- "$@"
fi
export SCIO_API_KEY="$key" SCIO_HARNESS="${SCIO_HARNESS:-$(basename "$1")}"
exec "$@"
